FROM node:20-alpine

RUN apk add --no-cache git poppler-utils

WORKDIR /app

COPY scripts/api/package*.json ./
RUN npm ci --omit=dev

COPY scripts/api/ ./

ENV NODE_ENV=production
EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3002/health || exit 1

CMD ["node", "server.js"]
